<Project Sdk="Microsoft.NET.Sdk">
  <!-- Одноразовая утилита сверки: гоняет ровно тот же код, что и приложение,
       но из консоли, чтобы сравнить числа с Python. В релиз не входит. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MlCheck</RootNamespace>
    <AssemblyName>MlCheck</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../MessedUpSearchA/Services/Ml/AudioDecoder.cs" Link="AudioDecoder.cs" />
    <Compile Include="../../MessedUpSearchA/Services/Ml/ArtistIndex.cs" Link="ArtistIndex.cs" />
    <Compile Include="../../MessedUpSearchA/Services/Ml/BeatSimilarityService.cs" Link="BeatSimilarityService.cs" />
    <Compile Include="../../MessedUpSearchA/Services/Ml/MertEmbedder.cs" Link="MertEmbedder.cs" />
    <Compile Include="../../MessedUpSearchA/Services/Localization/Localizer.cs" Link="Localizer.cs" />
    <Compile Include="../../MessedUpSearchA/Services/Localization/LocalizationStrings.cs" Link="LocalizationStrings.cs" />
    <!-- Для режима online: качает превью Deezer тем же кодом, что и приложение. -->
    <Compile Include="../../MessedUpSearchA/Services/Parsing/ParsingHttp.cs" Link="ParsingHttp.cs" />
    <Compile Include="../../MessedUpSearchA/Services/Parsing/IAudioResolver.cs" Link="IAudioResolver.cs" />
    <Compile Include="../../MessedUpSearchA/Services/Parsing/AudioFetcher.cs" Link="AudioFetcher.cs" />
    <Compile Include="../../MessedUpSearchA/Services/Parsing/ArtistCandidate.cs" Link="ArtistCandidate.cs" />
    <Compile Include="../../MessedUpSearchA/Services/Parsing/Sources/DeezerSource.cs" Link="DeezerSource.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageReference Include="NLayer" Version="3.0.0" />
  </ItemGroup>
</Project>
