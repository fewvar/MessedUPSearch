<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MessedUpSearchA.ViewModels"
        xmlns:views="using:MessedUpSearchA.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="960"
        x:Class="MessedUpSearchA.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MessedUpSearchApp"
        Width="1280" Height="960"
        MinWidth="1100" MinHeight="780"
        Background="{StaticResource AppBackground}">

    <Window.Styles>
        <StyleInclude Source="/Assets/Styles/MainWindowStyles.axaml"/>
    </Window.Styles>

    <Grid>

        <!-- ============== BACKGROUND TEXTURE LAYER ============== -->
        <Rectangle Fill="{StaticResource BackgroundTexture}"/>

        <Grid Margin="72,40,72,16" RowDefinitions="180,*,Auto" RowSpacing="20">

        <!-- ============== TOP BAR ============== -->
        <Grid Grid.Row="0" x:CompileBindings="False">

            <!-- логотип + название (левый верхний угол) -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Spacing="14"
                        Margin="4,14,0,0">
                <Image Source="/Assets/Icons/logo.png"
                       Width="56" Height="56"
                       VerticalAlignment="Center"/>
                <TextBlock Text="MessedUpSearch"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="30"
                           FontWeight="Bold"
                           LetterSpacing="1"
                           Foreground="{StaticResource OnBackground}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- табы (анимированные овалы, по центру) -->
            <RadioButton Classes="tab"
                         IsChecked="{Binding IsBeatsSelected, Mode=TwoWay}"
                         Content="BEATS BASE"/>
            <RadioButton Classes="tab"
                         IsChecked="{Binding !IsBeatsSelected, Mode=TwoWay}"
                         Content="ARTISTS"/>
        </Grid>

        <!-- ============== ACTIVE VIEW ============== -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>

        <!-- ============== STATUS BAR ============== -->
        <Border Grid.Row="2"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,1,0,0"
                Padding="4,8,4,4"
                x:CompileBindings="False">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding ArtistsVm.Artists.Count, StringFormat='Artists: {0}'}"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="11" LetterSpacing="1"
                               Foreground="{StaticResource OnBackgroundDim}"/>
                    <TextBlock Text="•"
                               FontSize="11"
                               Foreground="{StaticResource OnBackgroundDim}"/>
                    <TextBlock Text="{Binding BeatsVm.Beats.Count, StringFormat='Beats: {0}'}"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="11" LetterSpacing="1"
                               Foreground="{StaticResource OnBackgroundDim}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding ParserStatus, StringFormat='PARSER: {0}'}"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="11" LetterSpacing="2"
                           Foreground="{StaticResource OnBackgroundDim}"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding AppVersion}"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="10" LetterSpacing="1"
                           Foreground="{StaticResource OnBackgroundDim}"
                           Opacity="0.7"/>
            </Grid>
        </Border>
        </Grid>

        <!-- ============== OVERLAYS ============== -->
        <Grid x:CompileBindings="False">
            <views:CrmOverlay IsVisible="{Binding IsCrmOpen}"/>
            <views:SettingsOverlay IsVisible="{Binding IsSettingsOpen}"/>
        </Grid>
    </Grid>
</Window>
