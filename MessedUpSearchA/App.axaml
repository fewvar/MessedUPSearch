<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MessedUpSearchA.ViewModels"
             xmlns:views="using:MessedUpSearchA.Views"
             x:Class="MessedUpSearchA.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <DataTemplate DataType="vm:BeatsViewModel">
            <views:BeatsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ArtistsViewModel">
            <views:ArtistsView/>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme/>
    </Application.Styles>
</Application>
