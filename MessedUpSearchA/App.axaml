<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MessedUpSearchA.ViewModels"
             xmlns:views="using:MessedUpSearchA.Views"
             xmlns:conv="using:MessedUpSearchA.Converters"
             x:Class="MessedUpSearchA.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <DataTemplate DataType="vm:BeatsViewModel">
            <views:BeatsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ArtistsViewModel">
            <views:ArtistsView/>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>

        <conv:StringToBrushConverter x:Key="StringToBrush"/>
        <conv:AvatarBrushConverter x:Key="AvatarBrush"/>

        <FontFamily x:Key="HeadingFont">avares://MessedUpSearchA/Assets/Fonts/Oswald-VariableFont_wght.ttf#Oswald</FontFamily>

        <FontFamily x:Key="BodyFont">avares://MessedUpSearchA/Assets/Fonts/JetBrainsMono-VariableFont_wght.ttf#JetBrains Mono</FontFamily>

        <SolidColorBrush x:Key="AppBackground"   Color="#040506"/>
        <SolidColorBrush x:Key="Surface"         Color="#C8C8C8"/>
        <SolidColorBrush x:Key="SurfaceActive"   Color="#E0E0E0"/>
        <SolidColorBrush x:Key="OnSurface"       Color="#1A1A1A"/>
        <SolidColorBrush x:Key="OnSurfaceMuted"  Color="#55585B"/>
        <SolidColorBrush x:Key="OnBackground"    Color="#C8C8C8"/>
        <!-- #6E7174 давал 4.15:1 на фоне — меньше нормы 4.5 для мелкого текста. -->
        <SolidColorBrush x:Key="OnBackgroundDim" Color="#7E8184"/>
        <!-- Ползунки Fluent по умолчанию системно-синие — единственный цвет посреди монохрома. -->
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#C8C8C8"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#C8C8C8"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Divider"         Color="#26000000"/>

        <ImageBrush x:Key="BackgroundTexture"
                    Source="avares://MessedUpSearchA/Assets/Textures/TexturesV1.0/bg-texture.png"
                    TileMode="FlipXY" Stretch="Fill" DestinationRect="0,0,1254,1254"
                    Opacity="0.12"/>
        <ImageBrush x:Key="WhiteTexture"
                    Source="avares://MessedUpSearchA/Assets/Textures/TexturesV1.0/white-texture.png"
                    TileMode="FlipXY" Stretch="Fill" DestinationRect="0,0,380,380"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        </Style>
        <Style Selector="UserControl">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        </Style>
    </Application.Styles>
</Application>
