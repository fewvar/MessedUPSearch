<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:motion="using:MessedUpSearchA.Motion"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MessedUpSearchA.ViewModels"
             xmlns:models="using:MessedUpSearchA.Models"
             xmlns:loc="using:MessedUpSearchA.Services.Localization"
             xmlns:conv="using:MessedUpSearchA.Converters"
             x:Class="MessedUpSearchA.Views.ArtistsView"
             x:DataType="vm:ArtistsViewModel">

    <UserControl.Styles>
        <StyleInclude Source="/Assets/Styles/MainWindowStyles.axaml"/>
    </UserControl.Styles>

    <Grid x:CompileBindings="False">
    <Grid RowDefinitions="44,*,Auto" RowSpacing="20">

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12">
            <Button Classes="action" Content="{loc:Tr Buttons.AddArtist}" Click="OnAddArtistClick"/>
            <Button Classes="action" Content="{loc:Tr Buttons.Parser}" Click="OnParserClick"/>
            <Button Classes="action" Click="OnCrmClick">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Classes="icon icon-crm" Width="18" Height="18"/>
                    <TextBlock Text="{loc:Tr Buttons.Crm}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Classes="action" Click="OnSettingsClick">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Classes="icon icon-settings" Width="18" Height="18"/>
                    <TextBlock Text="{loc:Tr Buttons.Settings}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Grid.Row="1" Classes="card" ClipToBounds="True">
            <Grid RowDefinitions="76,*"
                  ColumnDefinitions="60,1.8*,1.5*,1.3*,2.4*,1.2*">

                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Classes="colDivider"/>
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Classes="colDivider"/>
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Classes="colDivider"/>
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Classes="colDivider"/>
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Classes="colDivider"/>

                <TextBlock Grid.Row="0" Grid.Column="1" Classes="tableHeader" Text="{loc:Tr Artists.Nickname}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Classes="tableHeader" Text="{loc:Tr Artists.Genre}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Classes="tableHeader"
                           Text="{loc:Tr Artists.Plays}"
                           TextWrapping="Wrap"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Classes="tableHeader"
                           Text="{loc:Tr Artists.Links}"
                           TextWrapping="Wrap"
                           Margin="14,0,14,0"/>
                <TextBlock Grid.Row="0" Grid.Column="5" Classes="tableHeader" Text="{loc:Tr Artists.Language}"/>

                <!-- Клик по заголовку — сортировка ▼ -> ▲ -> сброс; «Ссылки» не сортируются. -->
                <Border Grid.Row="0" Grid.Column="1" Classes="sortHit" Tag="Nickname" PointerPressed="OnSortHeaderClick">
                    <TextBlock Classes="sortArrow"
                               Text="{Binding SortState, Converter={x:Static vm:SortArrowConverter.Instance}, ConverterParameter=Nickname}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Classes="sortHit" Tag="Genre" PointerPressed="OnSortHeaderClick">
                    <TextBlock Classes="sortArrow"
                               Text="{Binding SortState, Converter={x:Static vm:SortArrowConverter.Instance}, ConverterParameter=Genre}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Classes="sortHit" Tag="Plays" PointerPressed="OnSortHeaderClick">
                    <TextBlock Classes="sortArrow"
                               Text="{Binding SortState, Converter={x:Static vm:SortArrowConverter.Instance}, ConverterParameter=Plays}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="5" Classes="sortHit" Tag="Language" PointerPressed="OnSortHeaderClick">
                    <TextBlock Classes="sortArrow"
                               Text="{Binding SortState, Converter={x:Static vm:SortArrowConverter.Instance}, ConverterParameter=Language}"/>
                </Border>

                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6" Classes="headerDivider"/>

                <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ArtistsList" ItemsSource="{Binding Artists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:Artist">
                                <Grid Height="56"
                                      ColumnDefinitions="60,1.8*,1.5*,1.3*,2.4*,1.2*"
                                      Background="Transparent"
                                      Cursor="Hand"
                                      PointerPressed="OnArtistRowClick">
                                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6"
                                            BorderBrush="#22000000" BorderThickness="0,0,0,1"
                                            VerticalAlignment="Bottom" IsHitTestVisible="False"/>

                                    <Panel Grid.Column="0"
                                           Width="32" Height="32"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                        <!-- Цветной кружок виден, когда фото нет:
                                             у артистов, добавленных руками, и если
                                             файл аватарки пропал с диска. -->
                                        <Ellipse Fill="{Binding AvatarColor, Converter={StaticResource StringToBrush}}"/>
                                        <Ellipse Fill="{Binding AvatarPath, Converter={StaticResource AvatarBrush}}"/>
                                    </Panel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Nickname}"
                                               FontWeight="Bold" FontSize="15"
                                               Margin="14,0,8,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Nickname}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding AiGenreTags}"
                                               FontSize="14"
                                               Margin="14,0,8,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding AiGenreTags}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding TotalPlays, Converter={x:Static conv:CountConverter.Instance}}"
                                               FontSize="14"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>

                                    <!-- Пустые «inst:» и «spotify:» в каждой строке были шумом: показываем
                                         только то, что есть, а если нет ничего — прочерк. -->
                                    <StackPanel Grid.Column="4"
                                                Margin="14,0,14,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IgLink, StringFormat='inst: {0}'}"
                                                   IsVisible="{Binding IgLink, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   FontSize="13" Cursor="Hand"
                                                   TextTrimming="CharacterEllipsis"
                                                   PointerPressed="OnIgLinkClick"/>
                                        <TextBlock Text="{Binding SpotifyLink, StringFormat='spotify: {0}'}"
                                                   IsVisible="{Binding SpotifyLink, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   FontSize="13" Cursor="Hand"
                                                   TextTrimming="CharacterEllipsis"
                                                   PointerPressed="OnSpotifyLinkClick"/>
                                        <TextBlock Text="—" FontSize="13">
                                            <TextBlock.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="IgLink" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                                                    <Binding Path="SpotifyLink" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                                                </MultiBinding>
                                            </TextBlock.IsVisible>
                                        </TextBlock>
                                    </StackPanel>

                                    <Grid Grid.Column="5" ColumnDefinitions="*,Auto,Auto"
                                          Margin="14,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Language, Converter={x:Static conv:DataLabelConverter.Instance}, ConverterParameter=short}"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>

                                        <Panel Grid.Column="1"
                                               Background="Transparent" Cursor="Hand"
                                               Width="28" Height="28" Margin="4,0"
                                               VerticalAlignment="Center"
                                               PointerPressed="OnToggleFavorite"
                                               Name="FavoriteToggle">
                                            <Border Classes="icon icon-star-filled"
                                                    Background="#F1C40F"
                                                    Width="20" Height="20"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsVisible="{Binding IsFavorite}"/>
                                            <Border Classes="icon icon-star-outline surfaceMuted"
                                                    Width="20" Height="20"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsVisible="{Binding !IsFavorite}"/>
                                        </Panel>

                                        <Panel Grid.Column="2"
                                               Background="Transparent" Cursor="Hand"
                                               Width="28" Height="28" Margin="4,0,0,0"
                                               VerticalAlignment="Center"
                                               PointerPressed="OnToggleRedFlag"
                                               Name="FlagToggle">
                                            <TextBlock Text="⚑" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="#E74C3C"
                                                       IsVisible="{Binding IsRedFlagged}"/>
                                            <TextBlock Text="⚑" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource OnSurfaceMuted}"
                                                       Opacity="0.55"
                                                       IsVisible="{Binding !IsRedFlagged}"/>
                                        </Panel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6"
                      IsVisible="{Binding IsPreviewVisible}"
                      IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Top" Opacity="0.30">
                        <Grid Height="56" ColumnDefinitions="60,1.8*,1.5*,1.3*,2.4*,1.2*">
                            <Ellipse Grid.Column="0" Width="32" Height="32" Fill="#E74C3C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="KXSHDAMI" FontWeight="Bold" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Rage, Plugg" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="8120" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="4" Margin="14,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="inst: @kxshdami" FontSize="13"/>
                                <TextBlock Text="spotify: 23000" FontSize="13"/>
                            </StackPanel>
                            <TextBlock Grid.Column="5" Text="ENG" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Height="56" ColumnDefinitions="60,1.8*,1.5*,1.3*,2.4*,1.2*">
                            <Ellipse Grid.Column="0" Width="32" Height="32" Fill="#5DADE2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="NIGHTTEARS" FontWeight="Bold" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Sad, Cloud" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="6890" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="4" Margin="14,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="inst: @night.tears" FontSize="13"/>
                                <TextBlock Text="spotify: 9400" FontSize="13"/>
                            </StackPanel>
                            <TextBlock Grid.Column="5" Text="RU" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="{loc:Tr Artists.Empty}"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="15" LetterSpacing="1"
                               Foreground="{StaticResource OnSurfaceMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,2*" ColumnSpacing="14" Height="72">

            <Border Grid.Column="0" Classes="filterBox">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Classes="filterLabel" Text="{loc:Tr Filter.Type}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Classes="icon icon-type onSurface" Width="20" Height="20" VerticalAlignment="Center"/>
                    </Grid>
                    <ComboBox Grid.Row="1" Classes="filter"
                              ItemsSource="{Binding TypeOptions}"
                              SelectedItem="{Binding FilterType}"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="filterBox">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Classes="filterLabel" Text="{loc:Tr Filter.Plays}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Classes="icon icon-plays onSurface" Width="20" Height="20" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">
                        <TextBox Grid.Column="0" Classes="search" Text="{Binding PlaysMin}" PlaceholderText="{loc:Tr Filter.Min}"/>
                        <TextBlock Grid.Column="1" Classes="filterMuted" Text="—" Margin="8,0"/>
                        <TextBox Grid.Column="2" Classes="search" Text="{Binding PlaysMax}" PlaceholderText="{loc:Tr Filter.Max}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="filterBox">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Classes="filterLabel" Text="{loc:Tr Filter.Language}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Classes="icon icon-language onSurface" Width="20" Height="20" VerticalAlignment="Center"/>
                    </Grid>
                    <ComboBox Grid.Row="1" Classes="filter"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding FilterLanguage}"/>
                </Grid>
            </Border>

            <Border Grid.Column="3" Classes="filterBox">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Classes="filterLabel" Text="{loc:Tr Filter.Period}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Classes="icon icon-period onSurface" Width="20" Height="20" VerticalAlignment="Center"/>
                    </Grid>
                    <ComboBox Grid.Row="1" Classes="filter"
                              ItemsSource="{Binding PeriodOptions}"
                              SelectedItem="{Binding FilterPeriod}"/>
                </Grid>
            </Border>

            <Border Grid.Column="4" Classes="filterBox" Padding="20,8">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBox Grid.Column="0"
                             Classes="search"
                             Text="{Binding SearchText}"
                             PlaceholderText="{loc:Tr Filter.Search}"/>
                    <Border Grid.Column="1" Classes="icon icon-search onSurface" Width="20" Height="20"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <Grid IsVisible="False" motion:Motion.IsShown="{Binding IsEditorOpen}">
        <Border Background="#B0000000"/>
        <!-- Две колонки: слева поля, справа биты и треки. В одну колонку треки и подходящие
             биты уходили за нижний край окна. -->
        <Border Classes="modal" Width="960" Margin="0,12" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Margin="28,18,28,24" Spacing="12">
                <StackPanel.Styles>

                    <Style Selector="TextBlock.filterLabel">
                        <Setter Property="Foreground" Value="{StaticResource OnBackground}"/>
                    </Style>
                </StackPanel.Styles>

                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Panel Width="40" Height="40" VerticalAlignment="Center">
                            <Ellipse Fill="{Binding EditAvatarColor, Converter={StaticResource StringToBrush}}"/>
                            <Ellipse Fill="{Binding EditAvatarPath, Converter={StaticResource AvatarBrush}}"/>
                        </Panel>
                        <TextBlock Text="{Binding EditorTitle}"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontSize="20" FontWeight="Bold" LetterSpacing="3"
                                   Foreground="{StaticResource OnBackground}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Classes="modalClose" Content="✕"
                            HorizontalAlignment="Right"
                            Command="{Binding CancelCommand}"/>
                </Grid>

                <Grid ColumnDefinitions="*,32,*">
                <StackPanel Grid.Column="0" Spacing="12">
                <Grid ColumnDefinitions="*,14,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="{loc:Tr Artists.Nickname}"/>
                        <TextBox Text="{Binding EditNickname}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="{Binding ProfileLinkLabel}"/>
                        <TextBox Text="{Binding EditScLink}" PlaceholderText="{loc:Tr ArtistEditor.NoneHint}"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,14,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="{loc:Tr Artists.Genre}"/>
                        <TextBox Text="{Binding EditGenreTags}" PlaceholderText="Rage, Plugg"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="{loc:Tr Filter.Plays}"/>
                        <TextBox Text="{Binding EditTotalPlays}" PlaceholderText="8120"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,14,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="{loc:Tr ArtistEditor.Instagram}"/>
                        <TextBox Text="{Binding EditIgLink}" PlaceholderText="@nick"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="{loc:Tr ArtistEditor.Spotify}"/>
                        <TextBox Text="{Binding EditSpotifyLink}"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,14,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="{loc:Tr Filter.Language}"/>
                        <TextBox Text="{Binding EditLanguage}" PlaceholderText="{loc:Tr ArtistEditor.LanguageHint}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="{loc:Tr ArtistEditor.CrmStatus}"/>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding CrmStatusOptions}"
                                  SelectedItem="{Binding EditCrmStatus}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Classes="filterLabel" Text="{loc:Tr ArtistEditor.Notes}"/>
                    <TextBox Text="{Binding EditNotes}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Height="110"/>
                </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="12">
                <StackPanel Spacing="4" IsVisible="{Binding IsEditMode}">
                    <TextBlock Classes="filterLabel" Text="{loc:Tr ArtistEditor.AssignedBeats}"/>
                    <TextBlock Text="{loc:Tr ArtistEditor.NoAssignedBeats}"
                               IsVisible="{Binding !HasAssignedBeats}"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource OnBackgroundDim}"/>
                    <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8"
                            IsVisible="{Binding HasAssignedBeats}">
                        <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AssignedBeats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:Beat">
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                            <Ellipse Grid.Column="0" Width="10" Height="10"
                                                     Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{Binding StatusColor, Converter={StaticResource StringToBrush}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding BeatName}"
                                                       FontSize="13" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Classes="filterLabel" Text="{loc:Tr ArtistEditor.MatchingBeats}"/>

                    <TextBlock Text="{loc:Tr ArtistEditor.NoModel}"
                               IsVisible="{Binding !IsSimilarityAvailable}"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource OnBackgroundDim}"/>

                    <TextBlock Text="{loc:Tr ArtistEditor.UnknownArtist}"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource OnBackgroundDim}">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsSimilarityAvailable"/>
                                <Binding Path="!IsArtistKnownToModel"/>
                                <Binding Path="!HasSimilarBeats"/>
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>

                    <TextBlock Text="{loc:Tr ArtistEditor.NoMatches}"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource OnBackgroundDim}">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsArtistKnownToModel"/>
                                <Binding Path="!HasSimilarBeats"/>
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>

                    <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6"
                            Padding="10,8" IsVisible="{Binding HasSimilarBeats}">
                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SimilarBeats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:SimilarBeatItem">
                                        <Grid ColumnDefinitions="Auto,150,*,44" Margin="0,3">
                                            <Ellipse Grid.Column="0" Width="10" Height="10"
                                                     Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{Binding StatusColor, Converter={StaticResource StringToBrush}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding BeatName}"
                                                       FontSize="13" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2" Height="6" CornerRadius="3"
                                                    Background="#22FFFFFF" Margin="8,0"
                                                    VerticalAlignment="Center">
                                                <Border Height="6" CornerRadius="3"
                                                        Background="{StaticResource OnBackground}"
                                                        Width="{Binding BarWidth}"
                                                        HorizontalAlignment="Left"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding PercentLabel}"
                                                       FontSize="12" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource OnBackgroundDim}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Classes="filterLabel" Text="{loc:Tr ArtistEditor.Tracks}"/>

                    <TextBlock Text="{loc:Tr ArtistEditor.NoTracks}"
                               IsVisible="{Binding !HasTracks}"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource OnBackgroundDim}"/>

                    <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6"
                            Padding="6,4" IsVisible="{Binding HasTracks}">
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Tracks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ArtistTrackItem">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Button Grid.Column="0" Classes="playerButton" Click="OnPlayTrackClick">
                                                <Path Data="M0,0 L8,4.5 L0,9 Z"/>
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                       FontSize="13" Margin="4,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Meta}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource OnBackgroundDim}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" Classes="action" Content="{loc:Tr Buttons.Delete}"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding IsEditMode}"
                            Command="{Binding DeleteCommand}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                        <Button Classes="action" Content="{loc:Tr Buttons.Cancel}" Command="{Binding CancelCommand}"/>
                        <Button Classes="action" Content="{loc:Tr Buttons.Save}" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</UserControl>
