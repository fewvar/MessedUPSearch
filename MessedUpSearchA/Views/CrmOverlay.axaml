<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MessedUpSearchA.ViewModels"
             xmlns:models="using:MessedUpSearchA.Models"
             x:Class="MessedUpSearchA.Views.CrmOverlay"
             x:Name="CrmRoot"
             x:DataType="vm:MainWindowViewModel">

    <Grid>
        <Border Background="#B0000000" PointerPressed="OnBackdropClick"/>

        <Border Classes="modal" Width="880" Height="620">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Margin="28,18,18,0">
                    <TextBlock Text="CRM"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="22" FontWeight="Bold"
                               LetterSpacing="3"
                               Foreground="{StaticResource OnBackground}"
                               VerticalAlignment="Center"/>
                    <Button Classes="modalClose" Content="✕"
                            HorizontalAlignment="Right"
                            Click="OnCloseClick"/>
                </Grid>
                <Grid Grid.Row="1" Margin="28,16,18,22">

                    <!-- пустое состояние -->
                    <TextBlock IsVisible="{Binding IsCrmEmpty}"
                               Text="Пометь артистам CRM-статус на вкладке ARTISTS — они появятся здесь"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="15" LetterSpacing="1"
                               TextWrapping="Wrap" MaxWidth="420"
                               Foreground="{StaticResource OnBackgroundDim}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>

                    <!-- список CRM-карточек -->
                    <ScrollViewer IsVisible="{Binding !IsCrmEmpty}"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CrmEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:CrmEntry">
                                    <Border Background="#14FFFFFF"
                                            BorderBrush="#22FFFFFF" BorderThickness="1"
                                            CornerRadius="8" Padding="16,12" Margin="0,0,8,12">
                                        <StackPanel Spacing="8">

                                            <!-- ник + кол-во + статус -->
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Nickname}"
                                                           FontWeight="Bold" FontSize="16"
                                                           Foreground="{StaticResource OnBackground}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SentCountLabel}"
                                                           FontSize="12" Margin="0,0,12,0"
                                                           Foreground="{StaticResource OnBackgroundDim}"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="2"
                                                        Background="#2A2A2A"
                                                        CornerRadius="4" Padding="8,3"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CrmStatus}"
                                                               FontSize="11" FontWeight="Bold"
                                                               LetterSpacing="1"
                                                               Foreground="{StaticResource OnBackground}"/>
                                                </Border>
                                            </Grid>

                                            <!-- заметки -->
                                            <TextBlock Text="{Binding Notes}"
                                                       IsVisible="{Binding HasNotes}"
                                                       FontSize="13" TextWrapping="Wrap"
                                                       Foreground="{StaticResource OnBackgroundDim}"/>

                                            <!-- привязанные биты со статусом отправки -->
                                            <ItemsControl ItemsSource="{Binding Beats}"
                                                          IsVisible="{Binding HasBeats}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:CrmBeatItem">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3">
                                                            <Ellipse Grid.Column="0" Width="9" Height="9"
                                                                     Margin="0,0,8,0" VerticalAlignment="Center"
                                                                     Fill="{Binding StatusColor, Converter={StaticResource StringToBrush}}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding BeatName}"
                                                                       FontSize="13" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource OnBackground}"/>

                                                            <!-- ✅ отправлен -->
                                                            <TextBlock Grid.Column="2" Text="✓ sent"
                                                                       FontSize="12" FontWeight="Bold"
                                                                       Margin="8,0" VerticalAlignment="Center"
                                                                       Foreground="#2ECC71"
                                                                       IsVisible="{Binding IsSent}"/>

                                                            <!-- ⏳ ждёт + кнопка отметки -->
                                                            <TextBlock Grid.Column="2" Text="⏳ pending"
                                                                       FontSize="12"
                                                                       Margin="8,0" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource OnBackgroundDim}"
                                                                       IsVisible="{Binding IsPending}"/>
                                                            <Button Grid.Column="3" Content="MARK SENT"
                                                                    Classes="action"
                                                                    Padding="10,4" FontSize="11"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding IsPending}"
                                                                    x:CompileBindings="False"
                                                                    Command="{Binding DataContext.MarkSentCommand, ElementName=CrmRoot}"
                                                                    CommandParameter="{Binding LogId}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
