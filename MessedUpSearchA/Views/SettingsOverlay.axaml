<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MessedUpSearchA.ViewModels"
             xmlns:loc="using:MessedUpSearchA.Services.Localization"
             x:Class="MessedUpSearchA.Views.SettingsOverlay"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked"            Color="White"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked"          Color="White"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked"           Color="#040506"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#040506"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed"     Color="#C8C8C8"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed"   Color="#C8C8C8"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed"    Color="#040506"/>
    </UserControl.Resources>

    <Grid>
        <Border Background="#B0000000" PointerPressed="OnBackdropClick"/>

        <Border Classes="modal" Width="920" Margin="0,40" MaxHeight="900" VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto,*">

                <Grid Grid.Row="0" Margin="28,18,18,4">
                    <TextBlock Text="{loc:Tr Settings.Title}"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="22" FontWeight="Bold"
                               LetterSpacing="3"
                               Foreground="{StaticResource OnBackground}"
                               VerticalAlignment="Center"/>
                    <Button Classes="modalClose" Content="✕"
                            HorizontalAlignment="Right"
                            Click="OnCloseClick"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Padding="32,0,40,32"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">

                        <Border Classes="settingsSection">
                            <StackPanel>
                                <TextBlock Classes="settingsHeader" Text="{loc:Tr Settings.Reminders}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="settingsLabel" Text="{loc:Tr Settings.RemindAfter}"/>
                                        <TextBlock Classes="settingsHint"
                                                   Text="{loc:Tr Settings.RemindAfterHint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                Spacing="14" VerticalAlignment="Center">
                                        <Slider Width="220"
                                                Minimum="1" Maximum="14"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                x:CompileBindings="False"
                                                Value="{Binding ReminderDays}"/>
                                        <TextBlock Text="{Binding ReminderDaysLabel}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="15" FontWeight="Bold"
                                                   MinWidth="48"
                                                   Foreground="{StaticResource OnBackground}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="settingsSection">
                            <StackPanel>
                                <TextBlock Classes="settingsHeader" Text="{loc:Tr Settings.Parser}"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="settingsLabel" Text="{loc:Tr Settings.MediaFolder}"/>
                                        <TextBlock Classes="settingsHint"
                                                   Text="{Binding MediaFolder}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="420"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="action"
                                            Content="{loc:Tr Settings.Choose}"
                                            VerticalAlignment="Center"
                                            Click="OnChooseMediaFolderClick"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="settingsSection">
                            <StackPanel>
                                <TextBlock Classes="settingsHeader" Text="{loc:Tr Settings.ApiKeys}"/>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="settingsLabel" Text="{loc:Tr Settings.LastFmKey}"/>
                                        <TextBlock Classes="settingsHint"
                                                   Text="{loc:Tr Settings.LastFmHint}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Classes="settings" Width="260"
                                             Text="{Binding LastFmApiKey}"
                                             PasswordChar="•"
                                             VerticalAlignment="Center"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="settingsLabel" Text="{loc:Tr Settings.JamendoKey}"/>
                                        <TextBlock Classes="settingsHint"
                                                   Text="{loc:Tr Settings.JamendoHint}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Classes="settings" Width="260"
                                             Text="{Binding JamendoClientId}"
                                             PasswordChar="•"
                                             VerticalAlignment="Center"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="settingsLabel" Text="{loc:Tr Settings.GeniusKey}"/>
                                        <TextBlock Classes="settingsHint"
                                                   Text="{loc:Tr Settings.GeniusHint}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Classes="settings" Width="260"
                                             Text="{Binding GeniusAccessToken}"
                                             PasswordChar="•"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="settingsSection">
                            <StackPanel>
                                <TextBlock Classes="settingsHeader" Text="{loc:Tr Settings.Language}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="settingsLabel" Text="{loc:Tr Settings.InterfaceLanguage}"/>
                                        <TextBlock Classes="settingsHint"
                                                   Text="{loc:Tr Settings.InterfaceLanguageHint}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Classes="settings"
                                              ItemsSource="{Binding LanguageOptions}"
                                              SelectedItem="{Binding Language}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="settingsSection">
                            <StackPanel>
                                <TextBlock Classes="settingsHeader" Text="{loc:Tr Settings.Interface}"/>
                                <CheckBox Classes="settings"
                                          Content="{loc:Tr Settings.Animations}"
                                          IsChecked="{Binding Animations}"/>
                                <TextBlock Classes="settingsHint"
                                           Text="{loc:Tr Settings.AnimationsHint}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Classes="settingsHint"
                                           Text="{loc:Tr Settings.AnimationsSystem}"
                                           IsVisible="{Binding IsSystemReducedMotion}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <CheckBox Classes="settings"
                                          Content="{loc:Tr Settings.Sounds}"
                                          IsChecked="{Binding Sounds}"
                                          Margin="0,12,0,0"/>
                                <TextBlock Classes="settingsHint"
                                           Text="{loc:Tr Settings.SoundsHint}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="settingsSection">
                            <StackPanel>
                                <TextBlock Classes="settingsHeader" Text="{loc:Tr Settings.Logs}"/>

                                <CheckBox Classes="settings"
                                          Content="{loc:Tr Settings.EnableParserLogs}"
                                          IsChecked="{Binding EnableParserLogs}"
                                          Margin="0,0,0,12"/>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="settingsLabel" Text="{loc:Tr Settings.LogFile}"/>
                                        <TextBlock Classes="settingsHint"
                                                   Text="{Binding LogFilePath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="420"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="action"
                                            Content="{loc:Tr Settings.OpenFolder}"
                                            VerticalAlignment="Center"
                                            Click="OnOpenDataFolderClick"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="settingsSection last">
                            <StackPanel>
                                <TextBlock Classes="settingsHeader" Text="{loc:Tr Settings.About}"/>

                                <TextBlock Text="{Binding AppVersion, StringFormat='MessedUpSearch {0}'}"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontSize="14" FontWeight="Bold"
                                           LetterSpacing="2"
                                           Foreground="{StaticResource OnBackground}"
                                           Margin="0,0,0,8"/>

                                <TextBlock Classes="settingsAbout"
                                           TextWrapping="Wrap"
                                           Text="{loc:Tr Settings.AboutText}"/>
                                <TextBlock Classes="settingsAbout"
                                           TextWrapping="Wrap"
                                           Text="{loc:Tr Settings.BuiltWith}"
                                           Margin="0,8,0,2"/>
                                <TextBlock Classes="settingsAbout"
                                           TextWrapping="Wrap"
                                           Text="{loc:Tr Settings.ModelCredit}"
                                           Margin="0,0,0,2"/>
                                <TextBlock Classes="settingsAbout"
                                           TextWrapping="Wrap"
                                           Text="by @fewvar"/>
                                <TextBlock Classes="settingsAbout"
                                           TextWrapping="Wrap"
                                           Text="github.com/fewvar/MessedUPSearch"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
