<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MessedUpSearchA.ViewModels"
             xmlns:models="using:MessedUpSearchA.Models"
             x:Class="MessedUpSearchA.Views.BeatsView"
             x:DataType="vm:BeatsViewModel">

    <UserControl.Styles>
        <StyleInclude Source="/Assets/Styles/MainWindowStyles.axaml"/>
    </UserControl.Styles>

    <Grid>
    <Grid RowDefinitions="44,*,Auto" RowSpacing="20">

        <!-- ============== ACTION BUTTONS ============== -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12">
            <Button Classes="action" Content="+ ADD BEAT" Click="OnAddBeatClick"/>
            <Button Classes="action" Content="IMPORT FOLDER" Click="OnImportFolderClick"/>
        </StackPanel>

        <!-- ============== TABLE CARD ============== -->
        <Border Grid.Row="1" Classes="card" ClipToBounds="True">
            <Grid RowDefinitions="76,*"
                  ColumnDefinitions="60,2.2*,2*,1*,1.2*,1.4*,1.8*">

                <!-- vertical column dividers (span both rows) -->
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Classes="colDivider"/>
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Classes="colDivider"/>
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Classes="colDivider"/>
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Classes="colDivider"/>
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Classes="colDivider"/>
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="5" Classes="colDivider"/>

                <!-- header text -->
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="tableHeader" Text="BEAT NAME"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Classes="tableHeader" Text="TYPE / GENRE"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Classes="tableHeader" Text="BPM"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Classes="tableHeader" Text="KEY"/>
                <TextBlock Grid.Row="0" Grid.Column="5" Classes="tableHeader" Text="ADDED"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Classes="tableHeader" Text="STATUS"/>

                <!-- header underline -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" Classes="headerDivider"/>

                <!-- body -->
                <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Beats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:Beat">
                                <Grid Height="56"
                                      ColumnDefinitions="60,2.2*,2*,1*,1.2*,1.4*,1.8*"
                                      Background="Transparent"
                                      Cursor="Hand"
                                      PointerPressed="OnBeatRowClick"
                                      x:CompileBindings="False">
                                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7"
                                            BorderBrush="#22000000" BorderThickness="0,0,0,1"
                                            VerticalAlignment="Bottom" IsHitTestVisible="False"/>

                                    <Ellipse Grid.Column="0"
                                             Width="22" Height="22"
                                             Fill="{Binding StatusColor, Converter={StaticResource StringToBrush}}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding BeatName}"
                                               FontWeight="Bold" FontSize="15"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding AiTags}"
                                               FontSize="14"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Bpm}"
                                               FontSize="14"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Key}"
                                               FontSize="14"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="5"
                                               Text="{Binding Added}"
                                               FontSize="14"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="6"
                                               Text="{Binding Status}"
                                               FontWeight="Bold" FontSize="13"
                                               LetterSpacing="1"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============== FILTERS + SEARCH ============== -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,2*" ColumnSpacing="14" Height="72">

            <!-- TYPE -->
            <Border Grid.Column="0" Classes="filterBox">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Classes="filterLabel" Text="TYPE" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Classes="icon icon-type onSurface" Width="20" Height="20" VerticalAlignment="Center"/>
                    </Grid>
                    <ComboBox Grid.Row="1" Classes="filter"
                              ItemsSource="{Binding TypeOptions}"
                              SelectedItem="{Binding FilterType}"/>
                </Grid>
            </Border>

            <!-- BPM (у битов нет прослушиваний — фильтруем по темпу) -->
            <Border Grid.Column="1" Classes="filterBox">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Classes="filterLabel" Text="BPM" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Classes="icon icon-plays onSurface" Width="20" Height="20" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">
                        <TextBox Grid.Column="0" Classes="search" Text="{Binding BpmMin}" PlaceholderText="min"/>
                        <TextBlock Grid.Column="1" Classes="filterMuted" Text="—" Margin="8,0"/>
                        <TextBox Grid.Column="2" Classes="search" Text="{Binding BpmMax}" PlaceholderText="max"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- KEY -->
            <Border Grid.Column="2" Classes="filterBox">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="filterLabel" Text="KEY"/>
                    <ComboBox Grid.Row="1" Classes="filter"
                              ItemsSource="{Binding KeyOptions}"
                              SelectedItem="{Binding FilterKey}"/>
                </Grid>
            </Border>

            <!-- PERIOD -->
            <Border Grid.Column="3" Classes="filterBox">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Classes="filterLabel" Text="PERIOD" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Classes="icon icon-period onSurface" Width="20" Height="20" VerticalAlignment="Center"/>
                    </Grid>
                    <ComboBox Grid.Row="1" Classes="filter"
                              ItemsSource="{Binding PeriodOptions}"
                              SelectedItem="{Binding FilterPeriod}"/>
                </Grid>
            </Border>

            <!-- SEARCH -->
            <Border Grid.Column="4" Classes="filterBox" Padding="20,8">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBox Grid.Column="0"
                             Classes="search"
                             Text="{Binding SearchText}"
                             PlaceholderText="SEARCH (KEY WORD)"/>
                    <Border Grid.Column="1" Classes="icon icon-search onSurface" Width="20" Height="20"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <!-- ============== BEAT EDITOR MODAL ============== -->
    <Grid IsVisible="{Binding IsEditorOpen}">
        <Border Background="#B0000000"/>
        <Border Classes="modal" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Margin="28,18,28,24" Spacing="14">

                <Grid>
                    <TextBlock Text="{Binding EditorTitle}"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="20" FontWeight="Bold" LetterSpacing="3"
                               Foreground="{StaticResource OnBackground}"
                               VerticalAlignment="Center"/>
                    <Button Classes="modalClose" Content="✕"
                            HorizontalAlignment="Right"
                            Command="{Binding CancelCommand}"/>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Classes="filterLabel" Text="BEAT NAME"/>
                    <TextBox Text="{Binding EditName}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Classes="filterLabel" Text="TYPE / GENRE"/>
                    <TextBox Text="{Binding EditTags}" PlaceholderText="Rage, Plugg"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,14,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="BPM"/>
                        <TextBox Text="{Binding EditBpm}" PlaceholderText="145"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="KEY"/>
                        <TextBox Text="{Binding EditKey}" PlaceholderText="C minor"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,14,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="STATUS"/>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding EditStatus}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="LICENSE (IF SOLD)"/>
                        <TextBox Text="{Binding EditLicense}" PlaceholderText="WAV Lease"/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Classes="filterLabel" Text="ASSIGN TO ARTISTS"/>
                    <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ArtistPicks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ArtistPick">
                                        <CheckBox Content="{Binding Nickname}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <Grid Margin="0,8,0,0">
                    <Button Classes="action" Content="DELETE"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding IsEditMode}"
                            Command="{Binding DeleteCommand}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button Classes="action" Content="CANCEL" Command="{Binding CancelCommand}"/>
                        <Button Classes="action" Content="SAVE" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</UserControl>
