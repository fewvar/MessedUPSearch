<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MessedUpSearchA.ViewModels"
             xmlns:models="using:MessedUpSearchA.Models"
             xmlns:loc="using:MessedUpSearchA.Services.Localization"
             xmlns:conv="using:MessedUpSearchA.Converters"
             x:Class="MessedUpSearchA.Views.BeatsView"
             x:DataType="vm:BeatsViewModel">

    <UserControl.Styles>
        <StyleInclude Source="/Assets/Styles/MainWindowStyles.axaml"/>
        <!-- Строка бита, который сейчас в плеере. -->
        <Style Selector="Grid.beatRow.playing">
            <Setter Property="Background" Value="#1F000000"/>
        </Style>
        <Style Selector="Grid.beatRow Border.playMarker">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Grid.beatRow.playing Border.playMarker">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <Grid x:CompileBindings="False">
    <Grid RowDefinitions="44,*,Auto" RowSpacing="20">

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12">
            <Button Classes="action" Content="{loc:Tr Buttons.AddBeat}" Click="OnAddBeatClick"/>
            <Button Classes="action" Content="{loc:Tr Buttons.ImportFolder}" Click="OnImportFolderClick"/>
        </StackPanel>

        <Border Grid.Row="1" Classes="card" ClipToBounds="True">
            <Grid RowDefinitions="76,*"
                  ColumnDefinitions="60,2.2*,2*,1*,1.2*,1.4*,1.8*">

                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Classes="colDivider"/>
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Classes="colDivider"/>
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Classes="colDivider"/>
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Classes="colDivider"/>
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Classes="colDivider"/>
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="5" Classes="colDivider"/>

                <TextBlock Grid.Row="0" Grid.Column="1" Classes="tableHeader" Text="{loc:Tr Beats.Name}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Classes="tableHeader" Text="{loc:Tr Beats.Genre}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Classes="tableHeader" Text="{loc:Tr Beats.Bpm}"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Classes="tableHeader" Text="{loc:Tr Beats.Key}"/>
                <TextBlock Grid.Row="0" Grid.Column="5" Classes="tableHeader" Text="{loc:Tr Beats.Added}"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Classes="tableHeader" Text="{loc:Tr Beats.Status}"/>

                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" Classes="headerDivider"/>

                <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Beats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:Beat">
                                <Grid Height="56"
                                      Classes="beatRow"
                                      ColumnDefinitions="60,2.2*,2*,1*,1.2*,1.4*,1.8*"
                                      Background="Transparent"
                                      Cursor="Hand"
                                      PointerPressed="OnBeatRowClick">
                                    <Classes.playing>
                                        <MultiBinding Converter="{x:Static conv:EqualsMultiConverter.Instance}">
                                            <Binding Path="Id"/>
                                            <Binding Path="$parent[ItemsControl].DataContext.PlayingBeatId"/>
                                        </MultiBinding>
                                    </Classes.playing>
                                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7"
                                            BorderBrush="#22000000" BorderThickness="0,0,0,1"
                                            VerticalAlignment="Bottom" IsHitTestVisible="False"/>

                                    <!-- Метка играющей строки: одна лишь заливка отличалась от фона на 1.24:1 — не видно. -->
                                    <Border Grid.Column="0" Classes="playMarker" Width="4"
                                            HorizontalAlignment="Left" Background="{StaticResource OnSurface}"/>

                                    <!-- ▶ бита и точка статуса рядом: белый значок на жёлтом статусе не читался бы. -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Classes="rowPlay" Click="OnPlayBeatClick">
                                            <Panel>
                                                <Path Data="M0,0 L8,4.5 L0,9 Z">
                                                    <Path.IsVisible>
                                                        <MultiBinding Converter="{x:Static conv:RowPlayingConverter.Instance}"
                                                                      ConverterParameter="invert">
                                                            <Binding Path="Id"/>
                                                            <Binding Path="$parent[ItemsControl].DataContext.PlayingBeatId"/>
                                                            <Binding Path="$parent[ItemsControl].DataContext.IsPlayerPlaying"/>
                                                        </MultiBinding>
                                                    </Path.IsVisible>
                                                </Path>
                                                <Path Data="M0,0 H3 V9 H0 Z M5,0 H8 V9 H5 Z">
                                                    <Path.IsVisible>
                                                        <MultiBinding Converter="{x:Static conv:RowPlayingConverter.Instance}">
                                                            <Binding Path="Id"/>
                                                            <Binding Path="$parent[ItemsControl].DataContext.PlayingBeatId"/>
                                                            <Binding Path="$parent[ItemsControl].DataContext.IsPlayerPlaying"/>
                                                        </MultiBinding>
                                                    </Path.IsVisible>
                                                </Path>
                                            </Panel>
                                        </Button>
                                        <Ellipse Width="10" Height="10"
                                                 Fill="{Binding StatusColor, Converter={StaticResource StringToBrush}}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding BeatName}"
                                               FontWeight="Bold" FontSize="15"
                                               Margin="14,0,8,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding BeatName}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding AiTags}"
                                               FontSize="14"
                                               Margin="14,0,8,0"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Bpm, Converter={x:Static conv:CountConverter.Instance}}"
                                               FontSize="14"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Key}"
                                               FontSize="14"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="5"
                                               Text="{Binding Added}"
                                               FontSize="14"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="6"
                                               Text="{Binding Status}"
                                               FontWeight="Bold" FontSize="13"
                                               LetterSpacing="1"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7"
                      IsVisible="{Binding IsPreviewVisible}"
                      IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Top" Opacity="0.30">
                        <Grid Height="56" ColumnDefinitions="60,2.2*,2*,1*,1.2*,1.4*,1.8*">
                            <Ellipse Grid.Column="0" Width="22" Height="22" Fill="#F1C40F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="VOODOO" FontWeight="Bold" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Rage" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="145" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="C minor" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="2026-05-24" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="POTENTIAL" FontWeight="Bold" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Height="56" ColumnDefinitions="60,2.2*,2*,1*,1.2*,1.4*,1.8*">
                            <Ellipse Grid.Column="0" Width="22" Height="22" Fill="#2ECC71" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="LATE NIGHT" FontWeight="Bold" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Cloud, Sad" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="120" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="F# minor" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="2026-05-20" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="SOLD" FontWeight="Bold" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Height="56" ColumnDefinitions="60,2.2*,2*,1*,1.2*,1.4*,1.8*">
                            <Ellipse Grid.Column="0" Width="22" Height="22" Fill="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="NEON" FontWeight="Bold" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Plugg" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="160" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="A minor" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="2026-05-18" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="FREE" FontWeight="Bold" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="{loc:Tr Beats.Empty}"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="15" LetterSpacing="1"
                               Foreground="{StaticResource OnSurfaceMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,2*" ColumnSpacing="14" Height="72">

            <Border Grid.Column="0" Classes="filterBox">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Classes="filterLabel" Text="{loc:Tr Filter.Type}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Classes="icon icon-type onSurface" Width="20" Height="20" VerticalAlignment="Center"/>
                    </Grid>
                    <ComboBox Grid.Row="1" Classes="filter"
                              ItemsSource="{Binding TypeOptions}"
                              SelectedItem="{Binding FilterType}"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="filterBox">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Classes="filterLabel" Text="{loc:Tr Beats.Bpm}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Classes="icon icon-plays onSurface" Width="20" Height="20" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">
                        <TextBox Grid.Column="0" Classes="search" Text="{Binding BpmMin}" PlaceholderText="{loc:Tr Filter.Min}"/>
                        <TextBlock Grid.Column="1" Classes="filterMuted" Text="—" Margin="8,0"/>
                        <TextBox Grid.Column="2" Classes="search" Text="{Binding BpmMax}" PlaceholderText="{loc:Tr Filter.Max}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="filterBox">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="filterLabel" Text="{loc:Tr Beats.Key}"/>
                    <ComboBox Grid.Row="1" Classes="filter"
                              ItemsSource="{Binding KeyOptions}"
                              SelectedItem="{Binding FilterKey}"/>
                </Grid>
            </Border>

            <Border Grid.Column="3" Classes="filterBox">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Classes="filterLabel" Text="{loc:Tr Filter.Period}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Classes="icon icon-period onSurface" Width="20" Height="20" VerticalAlignment="Center"/>
                    </Grid>
                    <ComboBox Grid.Row="1" Classes="filter"
                              ItemsSource="{Binding PeriodOptions}"
                              SelectedItem="{Binding FilterPeriod}"/>
                </Grid>
            </Border>

            <Border Grid.Column="4" Classes="filterBox" Padding="20,8">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBox Grid.Column="0"
                             Classes="search"
                             Text="{Binding SearchText}"
                             PlaceholderText="{loc:Tr Filter.Search}"/>
                    <Border Grid.Column="1" Classes="icon icon-search onSurface" Width="20" Height="20"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <Grid IsVisible="{Binding IsEditorOpen}">
        <Border Background="#B0000000"/>
        <!-- Две колонки: в одну колонку «Похожие артисты» уезжали за нижний край окна,
             а это главное, ради чего карточку открывают. -->
        <Border Classes="modal" Width="920" Margin="0,12"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,18,28,24" Spacing="14">
                <StackPanel.Styles>

                    <Style Selector="TextBlock.filterLabel">
                        <Setter Property="Foreground" Value="{StaticResource OnBackground}"/>
                    </Style>
                </StackPanel.Styles>

                <Grid>
                    <TextBlock Text="{Binding EditorTitle}"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="20" FontWeight="Bold" LetterSpacing="3"
                               Foreground="{StaticResource OnBackground}"
                               VerticalAlignment="Center"/>
                    <Button Classes="modalClose" Content="✕"
                            HorizontalAlignment="Right"
                            Command="{Binding CancelCommand}"/>
                </Grid>

                <Grid ColumnDefinitions="*,32,*">
                <StackPanel Grid.Column="0" Spacing="14">
                <StackPanel Spacing="4">
                    <TextBlock Classes="filterLabel" Text="{loc:Tr Beats.Name}"/>
                    <TextBox Text="{Binding EditName}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Classes="filterLabel" Text="{loc:Tr Beats.Genre}"/>
                    <TextBox Text="{Binding EditTags}" PlaceholderText="Rage, Plugg"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,14,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="{loc:Tr Beats.Bpm}"/>
                        <TextBox Text="{Binding EditBpm}" PlaceholderText="145"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="{loc:Tr Beats.Key}"/>
                        <TextBox Text="{Binding EditKey}" PlaceholderText="C minor"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,14,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="{loc:Tr Beats.Status}"/>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding EditStatus}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="filterLabel" Text="{loc:Tr BeatEditor.License}"/>
                        <TextBox Text="{Binding EditLicense}" PlaceholderText="WAV Lease"/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Classes="filterLabel" Text="{loc:Tr BeatEditor.AssignArtists}"/>
                    <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ArtistPicks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ArtistPick">
                                        <CheckBox Content="{Binding Nickname}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="filterLabel" Text="{loc:Tr BeatEditor.Similar}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="action" Content="{loc:Tr BeatEditor.Analyze}"
                                    IsVisible="{Binding !IsAnalyzing}"
                                    Command="{Binding AnalyzeSimilarityCommand}"/>
                            <Button Classes="action" Content="{loc:Tr BeatEditor.Stop}"
                                    IsVisible="{Binding IsAnalyzing}"
                                    Command="{Binding CancelAnalysisCommand}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding AnalysisStatus}"
                               IsVisible="{Binding AnalysisStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource OnBackgroundDim}"/>

                    <TextBlock Text="{loc:Tr BeatEditor.SimilarHint}"
                               IsVisible="{Binding ShowSimilarHint}"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource OnBackgroundDim}"/>

                    <TextBlock Text="{Binding StyleReferences}"
                               IsVisible="{Binding StyleReferences, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,2,0,6"
                               Foreground="{StaticResource OnBackgroundDim}"/>

                    <ItemsControl ItemsSource="{Binding SimilarArtists}"
                                  IsVisible="{Binding HasSimilarity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SimilarArtistItem">
                                <Grid ColumnDefinitions="150,*,40,Auto" Margin="0,1">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Artist}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource OnBackground}"/>
                                    <Border Grid.Column="1" Height="6" CornerRadius="3"
                                            Background="#22FFFFFF"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center">
                                        <Border Height="6" CornerRadius="3"
                                                Background="{StaticResource OnBackground}"
                                                Width="{Binding BarWidth}"
                                                HorizontalAlignment="Left"/>
                                    </Border>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding PercentLabel}"
                                               FontSize="12"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource OnBackgroundDim}"/>

                                    <!-- ▶ послушать · ➕ в базу (если его там нет) · ↗ профиль -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button Classes="playerButton" Click="OnPlaySimilarClick"
                                                ToolTip.Tip="{loc:Tr BeatEditor.PlayTrack}">
                                            <Path Data="M0,0 L8,4.5 L0,9 Z"/>
                                        </Button>
                                        <Panel Width="30">
                                            <Button Classes="playerButton" Click="OnImportSimilarClick"
                                                    IsVisible="{Binding CanImport}"
                                                    ToolTip.Tip="{loc:Tr BeatEditor.AddToBase}">
                                                <Path Data="M4,0 H6 V4 H10 V6 H6 V10 H4 V6 H0 V4 H4 Z"/>
                                            </Button>
                                        </Panel>
                                        <Button Classes="playerButton" Click="OnOpenSimilarClick"
                                                IsVisible="{Binding CanOpen}"
                                                ToolTip.Tip="{loc:Tr BeatEditor.OpenProfile}">
                                            <Path Data="M3,0 H10 V7 H8 V3.4 L1.4,10 L0,8.6 L6.6,2 H3 Z"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" Classes="action" Content="{loc:Tr Buttons.Delete}"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding IsEditMode}"
                            Command="{Binding DeleteCommand}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                        <Button Classes="action" Content="{loc:Tr Buttons.Cancel}" Command="{Binding CancelCommand}"/>
                        <Button Classes="action" Content="{loc:Tr Buttons.Save}" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
    </Grid>
</UserControl>
