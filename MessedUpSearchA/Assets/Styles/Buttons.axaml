<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Button.action">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource OnBackgroundDim}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground" Value="{StaticResource OnBackgroundDim}"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="MinWidth" Value="170"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                <BrushTransition Property="Foreground"  Duration="0:0:0.15"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1.5"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        Padding="20,10">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{TemplateBinding Foreground}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.action:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource OnBackground}"/>
        <Setter Property="Foreground"  Value="{StaticResource OnBackground}"/>
    </Style>

    <Style Selector="Button.action Border.icon">
        <Setter Property="Background" Value="{StaticResource OnBackgroundDim}"/>
    </Style>
    <Style Selector="Button.action:pointerover Border.icon">
        <Setter Property="Background" Value="{StaticResource OnBackground}"/>
    </Style>

    <Style Selector="Button.modalClose">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource OnBackgroundDim}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.modalClose:pointerover">
        <Setter Property="Foreground" Value="{StaticResource OnBackground}"/>
    </Style>

    <!-- Кнопки плеера: только значок, без рамки. Значки — Path, красятся через Fill. -->
    <Style Selector="Button.playerButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border Background="Transparent" Width="30" Height="30" CornerRadius="4">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.playerButton Path">
        <Setter Property="Fill" Value="{StaticResource OnBackgroundDim}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Fill" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.playerButton:pointerover Path">
        <Setter Property="Fill" Value="{StaticResource OnBackground}"/>
    </Style>

    <!-- ▶ в строке таблицы: тёмный квадрат на светлой карточке. -->
    <Style Selector="Button.rowPlay">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border Name="box" Background="{StaticResource OnSurface}" Width="24" Height="24" CornerRadius="4">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.12"/>
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.rowPlay Path">
        <Setter Property="Fill" Value="{StaticResource Surface}"/>
    </Style>
    <Style Selector="Button.rowPlay:pointerover /template/ Border#box">
        <Setter Property="Background" Value="{StaticResource OnSurfaceMuted}"/>
    </Style>

    <!-- Мелкая текстовая кнопка для строки состояния. -->
    <Style Selector="Button.statusButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource OnBackgroundDim}"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="1"
                        CornerRadius="3" Padding="8,1" Background="Transparent">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      FontFamily="{StaticResource HeadingFont}"
                                      FontSize="10"
                                      Foreground="{TemplateBinding Foreground}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.statusButton:pointerover">
        <Setter Property="Foreground" Value="{StaticResource OnBackground}"/>
    </Style>

    <!-- Нажатие: лёгкое «вдавливание» (Fluent делает scale(0.98) мгновенно — здесь плавно, 100 мс). -->
    <Style Selector="Button.action, Button.modalClose, Button.playerButton, Button.rowPlay, Button.statusButton">
        <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>
    <Style Selector="Button.action:pressed, Button.modalClose:pressed, Button.playerButton:pressed, Button.rowPlay:pressed, Button.statusButton:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>

    <!-- «Уменьшить движение»: без масштаба при нажатии, смена цвета остаётся (Apple это допускает). -->
    <Style Selector="Window.reduceMotion Button:pressed">
        <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>
</Styles>
