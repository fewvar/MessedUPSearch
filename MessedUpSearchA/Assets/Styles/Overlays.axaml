<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Border.modal">
        <Setter Property="Background" Value="{StaticResource AppBackground}"/>
        <!-- Стеклянная грань: сверху рамка светлее, к низу тает — как свет, падающий на край карточки. -->
        <Setter Property="BorderBrush">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#66FFFFFF" Offset="0"/>
                <GradientStop Color="#26FFFFFF" Offset="0.08"/>
                <GradientStop Color="#1AFFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BoxShadow" Value="0 16 48 0 #B0000000, inset 0 1 0 0 #14FFFFFF"/>
    </Style>

    <Style Selector="Border.settingsSection">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#22FFFFFF"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,14,0,18"/>
    </Style>

    <Style Selector="Border.settingsSection.last">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TextBlock.settingsHeader">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="3"/>
        <Setter Property="Foreground" Value="{StaticResource OnBackground}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style Selector="TextBlock.settingsLabel">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource OnBackground}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.settingsHint">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource OnBackgroundDim}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style Selector="TextBlock.settingsAbout">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource OnBackgroundDim}"/>
        <Setter Property="Margin" Value="0,2,0,2"/>
    </Style>

    <Style Selector="ComboBox.settings">
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Background" Value="#1A1C20"/>
        <Setter Property="Foreground" Value="{StaticResource OnBackground}"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="PlaceholderForeground" Value="{StaticResource OnBackgroundDim}"/>
    </Style>

    <Style Selector="TextBox.settings">
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Background" Value="#1A1C20"/>
        <Setter Property="Foreground" Value="{StaticResource OnBackground}"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style Selector="CheckBox.settings">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource OnBackground}"/>
    </Style>

</Styles>
