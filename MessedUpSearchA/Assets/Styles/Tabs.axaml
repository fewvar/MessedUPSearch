<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:motion="using:MessedUpSearchA.Motion">

    <Style Selector="RadioButton.tab">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="62"/>
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#2A2A2A"/>
        <Setter Property="Background" Value="#9A9A9A"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,96,0,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <!-- Пружина без отскока, ощущаемая длительность 0.35 с (анимация идёт 1.5 × 0.35). -->
                <DoubleTransition Property="Width" Duration="0:0:0.525">
                    <DoubleTransition.Easing><motion:SpringEasing/></DoubleTransition.Easing>
                </DoubleTransition>
                <DoubleTransition Property="Height" Duration="0:0:0.525">
                    <DoubleTransition.Easing><motion:SpringEasing/></DoubleTransition.Easing>
                </DoubleTransition>
                <DoubleTransition Property="FontSize" Duration="0:0:0.525">
                    <DoubleTransition.Easing><motion:SpringEasing/></DoubleTransition.Easing>
                </DoubleTransition>
                <ThicknessTransition Property="Margin" Duration="0:0:0.525">
                    <ThicknessTransition.Easing><motion:SpringEasing/></ThicknessTransition.Easing>
                </ThicknessTransition>
                <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="RadioButton">
                <Grid>
                    <Ellipse Fill="{TemplateBinding Background}"/>
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton.tab /template/ ContentPresenter">
        <Setter Property="TextBlock.LetterSpacing" Value="2"/>
    </Style>

    <Style Selector="RadioButton.tab:checked">
        <Setter Property="Width" Value="460"/>
        <Setter Property="Height" Value="84"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Background" Value="{StaticResource SurfaceActive}"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
    </Style>


    <!-- «Уменьшить движение»: вкладки меняются сразу (Motion ставит класс на окно). -->
    <Style Selector="Window.reduceMotion RadioButton.tab">
        <Setter Property="Transitions">
            <Transitions/>
        </Setter>
    </Style>
</Styles>
