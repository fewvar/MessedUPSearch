<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:MessedUpSearchA.Converters">

    <Style Selector="Border.filterBox">
        <Setter Property="Background" Value="#E8E8E8"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="16,8"/>
    </Style>

    <Style Selector="TextBlock.filterLabel">
        <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="1"/>
    </Style>

    <Style Selector="TextBlock.filterMuted">
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceMuted}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox.search">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        <Setter Property="CaretBrush" Value="{StaticResource OnSurface}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <!-- Плейсхолдер красится свойством, а не через PART_Watermark: в Avalonia 12 такого
         элемента в шаблоне нет, стиль молча не применялся и текст был почти белым (1.07:1). -->
    <Style Selector="TextBox.search">
        <Setter Property="PlaceholderForeground" Value="{StaticResource OnSurfaceMuted}"/>
    </Style>
    <!-- Fluent рисует плейсхолдер полупрозрачным: вместо 5.8:1 выходило 2.1:1. -->
    <Style Selector="TextBox.search /template/ :is(Control)#PART_Placeholder">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="TextBlock.searchIcon">
        <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="ComboBox.filter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="PlaceholderForeground" Value="{StaticResource OnSurface}"/>
        <!-- «ALL», «All time», «Common» — данные; на экране переводим, см. DataLabelConverter. -->
        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding Converter={x:Static conv:DataLabelConverter.Instance}}"/>
            </DataTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="ComboBox" x:CompileBindings="False">
                <Grid x:Name="PART_Root" ColumnDefinitions="*,Auto">
                    <ContentControl Grid.Column="0"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding ItemTemplate}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="18"
                                    FontWeight="Bold"/>
                    <TextBlock Grid.Column="1"
                               Text="▼"
                               FontSize="12"
                               Foreground="{StaticResource OnSurface}"
                               VerticalAlignment="Center"/>
                    <Popup Name="PART_Popup"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           WindowManagerAddShadowHint="False"
                           IsOpen="{Binding $parent[ComboBox].IsDropDownOpen, Mode=TwoWay}"
                           MinWidth="{Binding #PART_Root.Bounds.Width}"
                           PlacementTarget="{Binding #PART_Root}">
                        <Border Background="{StaticResource Surface}"
                                BorderBrush="#33000000"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4"
                                Margin="0,6,0,0">
                            <ScrollViewer MaxHeight="280">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ComboBox.filter ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ComboBox.filter ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#11000000"/>
        <Setter Property="TextBlock.Foreground" Value="{StaticResource OnSurface}"/>
    </Style>
    <Style Selector="ComboBox.filter ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#1A000000"/>
        <Setter Property="TextBlock.Foreground" Value="{StaticResource OnSurface}"/>
    </Style>

</Styles>
